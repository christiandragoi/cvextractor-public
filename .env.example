# OpenAI / LLM settings (optional — app works in demo mode without these)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database (SQLite inside Docker volume — persists across restarts)
DATABASE_URL=sqlite+aiosqlite:///app/data/cv_extractor.db

# Storage root for uploads and outputs (Docker volume path)
STORAGE_ROOT=/app/storage

# CORS origins (comma-separated; keep * for development, lock down in production)
CORS_ORIGINS=*
